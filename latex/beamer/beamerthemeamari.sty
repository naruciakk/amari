\newcommand{\fullframe}[2][]{
	\ifthenelse{\equal{#1}{}}{
		\begin{frame}[plain,nonavigation]
			\begin{tikzpicture}
				\useasboundingbox (1cm, 0) rectangle(\slidewidth,\slideheight);
				\fill[color=AmariAccent] (0, 0) rectangle(\slidewidth,\slideheight);
				\node[text width=\the\paperwidth-1cm,align=center] at (0.5\slidewidth, 0.5\slideheight) {\color{AmariBaseText}\Large\contour{AmariBaseBackground}{\owowhatsthis{#2}}};
			\end{tikzpicture}
		\end{frame}
	}{
		\begin{frame}[plain,nonavigation,image=#1]
			\begin{tikzpicture}
				\useasboundingbox (1cm, 0) rectangle(\slidewidth,\slideheight);
				\node[text width=\the\paperwidth,align=center] at (0.5\slidewidth, 0.5\slideheight) {\color{AmariBaseText}\Large\contour{AmariBaseBackground}{\owowhatsthis{#2}}};
			\end{tikzpicture}
		\end{frame}
	}
}

% custom section
\newcommand{\fumi}[2][]{
    \section{#2}
    \ifthenelse{\equal{#1}{}}{
        \begin{frame}
            \begin{tikzpicture}
                \useasboundingbox (1cm,0) rectangle(\slidewidth,\slideheight);
                \fill[color=AmariAccent] (0, 6cm) rectangle(\slidewidth,\slideheight+1mm);
                \draw[color=AmariBaseText, line width=0.5pt] (0, 6cm) -- (\slidewidth, 6cm);
                
                % Invisible diagonal path to calculate the exact geometric center of the rectangle
                \path (0, 6cm) -- (\slidewidth, \slideheight+1mm) 
                    node[midway, text width=\slidewidth, align=center] 
                    {\color{AmariBaseText}\Large\contour{AmariBaseBackground}{\owowhatsthis{#2}}};
            \end{tikzpicture}
        \end{frame}
    }{
        \begin{frame}[image=#1]
            \begin{tikzpicture}
                \useasboundingbox (1cm,0) rectangle(\slidewidth,\slideheight);
                \fill[color=AmariAccent, opacity=0.8] (0, 6cm) rectangle(\slidewidth,\slideheight+1mm);
                \draw[color=AmariBaseText, line width=0.5pt] (0, 6cm) -- (\slidewidth, 6cm);
                
                % Applied the same centering trick here for the image-background frame
                \path (0, 6cm) -- (\slidewidth, \slideheight+1mm) 
                    node[midway, text width=\slidewidth, align=center] 
                    {\color{AmariBaseText}\Large\contour{AmariBaseBackground}{\owowhatsthis{#2}}};
            \end{tikzpicture}
        \end{frame}
    }
}

\newcommand{\subfumi}[2][]{
    \subsection{#2}
    \ifthenelse{\equal{#1}{}}{
        \begin{frame}
            \begin{tikzpicture}
                \useasboundingbox (1cm,0) rectangle(\slidewidth,\slideheight);
                \fill[color=AmariAccent] (0, 6cm) rectangle(\slidewidth,\slideheight+1mm);
                \draw[color=AmariBaseText, line width=0.5pt] (0, 6cm) -- (\slidewidth, 6cm);
                
                % Centered path tracking the exact rectangle coordinates
                \path (0, 6cm) -- (\slidewidth, \slideheight-0.15cm) 
                    node[midway, text width=\slidewidth, align=center] {
                        \color{AmariBaseText}
                        {\small\contour{AmariBaseBackground}{\owowhatsthis{\insertsection}}}\\[0.2em]
                        {\large\contour{AmariBaseBackground}{\owowhatsthis{#2}}}
                    };
            \end{tikzpicture}
        \end{frame}
    }{
        \begin{frame}[image=#1]
            \begin{tikzpicture}
                \useasboundingbox (1cm,0) rectangle(\slidewidth,\slideheight);
                \fill[color=AmariAccent] (0, 6cm) rectangle(\slidewidth,\slideheight+1mm);
                \draw[color=AmariBaseText, line width=0.5pt] (0, 6cm) -- (\slidewidth, 6cm);
                
                % Centered path tracking the exact rectangle coordinates
                \path (0, 6cm) -- (\slidewidth, \slideheight-0.15cm) 
                    node[midway, text width=\slidewidth, align=center] {
                        \color{AmariBaseText}
                        {\small\contour{AmariBaseBackground}{\owowhatsthis{\insertsection}}}\\[0.2em]
                        {\large\contour{AmariBaseBackground}{\owowhatsthis{#2}}}
                    };
            \end{tikzpicture}
        \end{frame}
    }
}
